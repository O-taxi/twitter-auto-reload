{
    "manifest_version": 3,
    "name": "Twitter Auto Refresher",
    "version": "1.1",
    "icons": {
        "16": "./images/icon.png",
        "48": "./images/icon.png",
        "128": "./images/icon.png"
    },
    "action": {
        "default_popup": "src/popup.html",
        "default_icon": {
            "16": "./images/icon.png",
            "48": "./images/icon.png",
            "128": "./images/icon.png"
        }
    },
    "permissions": [
        "tabs", 
        "scripting", 
        "alarms",
        "storage"
    ],
    "host_permissions": [
        "*://*.x.com/*"
    ],
    "background": {
        "service_worker": "src/background.js"
    }
}
